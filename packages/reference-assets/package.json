{
  "name": "@iwsdk/reference-assets",
  "version": "1.1.0-rc.1",
  "description": "Producer pipeline for the reference corpus that @iwsdk/reference bundles",
  "private": true,
  "type": "module",
  "scripts": {
    "build:tools": "tsc -p tsconfig.tools.json",
    "ingest": "npm run build:tools && node dist-tools/tools/ingest.js",
    "build": "npm run ingest",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/facebook/immersive-web-sdk.git",
    "directory": "packages/reference-assets"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "glob": "^12.0.0",
    "ts-morph": "^27.0.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
