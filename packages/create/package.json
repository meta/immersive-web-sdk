{
  "name": "@iwsdk/create",
  "version": "1.1.0",
  "description": "Interactive CLI to scaffold Immersive Web SDK starter apps",
  "type": "module",
  "private": false,
  "bin": {
    "create-iwsdk": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/guidance",
    "dist/template",
    "scripts/verify-release-ready.mjs",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node scripts/gen-version.cjs && node scripts/ensure-cli-build.mjs && node scripts/build-template.mjs",
    "prepublishOnly": "npm run build && npm run verify:release-ready",
    "build": "rollup -c",
    "dev": "npm run --silent build && node dist/cli.js",
    "watch": "rollup -c --watch",
    "clean": "rm -rf dist",
    "test": "npm --prefix ../scene-composition run build && npm --prefix ../cli run build && npm run build && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:release-ready": "node scripts/verify-release-ready.mjs"
  },
  "keywords": [
    "create",
    "cli",
    "iwsdk",
    "starter",
    "scaffold"
  ],
  "author": "Felix Zhang <fe1ix@meta.com>",
  "license": "MIT",
  "homepage": "https://github.com/facebook/immersive-web-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facebook/immersive-web-sdk.git"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.0",
    "cross-spawn": "^7.0.6",
    "ora": "^8.2.0",
    "prompts": "^2.4.2",
    "semver": "^7.6.3",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@iwsdk/cli": "workspace:*",
    "@iwsdk/core": "workspace:*",
    "@iwsdk/scene-composition": "workspace:*",
    "@types/cross-spawn": "^6.0.6",
    "@types/prompts": "^2.4.9",
    "@types/semver": "^7.5.8",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
