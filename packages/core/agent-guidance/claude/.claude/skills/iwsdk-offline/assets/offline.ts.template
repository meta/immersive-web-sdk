// src/offline.ts: the page's side. Call startOffline() first thing at startup, keepOfflineCopy()
// once the first screen is up, and checkIdle() whenever the app becomes idle (an XR session ends).
// isIdle() is your app's own test: would a reload now interrupt nothing?

export function startOffline(isIdle: () => boolean): void {
  if (!('serviceWorker' in navigator)) return;
  const hadCopy = navigator.serviceWorker.controller != null;
  navigator.serviceWorker
    .getRegistration()
    .then((registration) => {
      if (registration == null) return;
      // A release that finished installing on an earlier visit takes over before anything starts.
      if (registration.waiting != null && hadCopy)
        takeOver(registration.waiting);
      else watch(registration, isIdle);
    })
    .catch(() => {});
}

export function keepOfflineCopy(isIdle: () => boolean): void {
  if (!('serviceWorker' in navigator)) return;
  navigator.serviceWorker
    .register('./sw.js', { scope: './' })
    .then((registration) => {
      watch(registration, isIdle);
      // Ask the browser not to evict the copy under storage pressure. It decides without a prompt.
      navigator.storage?.persist?.().catch(() => {});
      // Tell the worker what the page fetched before it took control, so it can keep optional files.
      new PerformanceObserver((list) => {
        const fetched = list.getEntries().map((entry) => entry.name);
        navigator.serviceWorker.ready.then((ready) =>
          ready.active?.postMessage({ fetched }),
        );
      }).observe({ type: 'resource', buffered: true });
    })
    .catch(() => {
      // No offline copy (storage turned off, some private windows): the app still runs online.
    });
}

// A release that installed while the app was busy waits; call this when the app becomes idle to
// let it take over now rather than at the next load.
export function checkIdle(): void {
  retry?.();
}

const watched = new WeakSet<ServiceWorkerRegistration>();
let retry: (() => void) | undefined;

function watch(
  registration: ServiceWorkerRegistration,
  isIdle: () => boolean,
): void {
  if (watched.has(registration)) return;
  watched.add(registration);
  const follow = (worker: ServiceWorker | null) => {
    if (worker == null) return;
    const settled = () => {
      // Otherwise the release waits, and the next load takes it at startup.
      if (
        worker.state === 'installed' &&
        navigator.serviceWorker.controller != null &&
        isIdle()
      ) {
        takeOver(worker);
      }
    };
    if (worker.state === 'installed') settled();
    else worker.addEventListener('statechange', settled);
  };
  retry = () => follow(registration.waiting);
  follow(registration.waiting);
  follow(registration.installing); // an update the navigation started before this script ran
  registration.addEventListener('updatefound', () =>
    follow(registration.installing),
  );
}

let listening = false;

// The worker takes over only if this is the only page of the app open; asking again later is safe.
function takeOver(worker: ServiceWorker): void {
  if (!listening) {
    listening = true;
    navigator.serviceWorker.addEventListener(
      'controllerchange',
      () => location.reload(),
      { once: true },
    );
  }
  worker.postMessage('take-over');
}
