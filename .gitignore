# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Package lock files in examples (these should be generated locally)
examples/**/package-lock.json

# Build outputs
dist/
lib/
build/
*.tgz

# Distributable SDK bundle (generated by scripts/build-sdk-bundle.sh)
/sdk-bundle/

# TypeScript/ESLint caches
**/*.tsbuildinfo
.eslintcache

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# Temporary directories
tmp/
temp/

# Husky (keep hooks in repo; ignore Husky's internal runtime dir)
.husky/_

# Development tools
.aider.conf.yml
# Claude Code: un-ignore root .claude/ (overrides parent repo's blanket ignore)
# Track shared config (settings.uikitml, agents/, skills/) but not personal files.
!.claude/
.claude/settings.local.json
.claude/**/.DS_Store
.claude/**/*.local.*
.claude/mcp-feedback.jsonl
# Example/package .claude dirs are local-only — don't track
examples/**/.claude/
packages/**/.claude/
# ...except the canonical guidance @iwsdk/create scaffolds into new apps
!packages/create/guidance/claude/.claude/
.codex/
.cursor/
.mcp.json

# Backup files created by build scripts
**/package.json.backup

# Vite/VitePress caches
.vite/
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/api/

# Generated JavaScript starter (built from /starter)
/starter-js/

# Auto generated version files
**/version.ts
**/version.js

# Local playground (created via `node packages/create/dist/cli.js playground`)
/playground/

# IWSDK dev tool runtime state
.iwsdk/

# Local-only notes and artifacts (kept on disk, never committed)
/.local/
